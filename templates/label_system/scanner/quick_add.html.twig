{% extends 'main_card.html.twig' %}

{% block card_title %}
    <i class="fas fa-camera-retro fa-fw"></i> Quick Scan Add
{% endblock %}

{% block card_content %}
    <div class="alert alert-warning d-none" id="scanner-warning">
        <strong>No camera found</strong>: Please check camera permissions in your browser.
    </div>

    <div id="quick-add-status" class="alert d-none"></div>

    <div class="img-thumbnail" style="max-width: 700px;">
        <div
            id="quick-add-reader"
            {{ stimulus_controller('pages/quick_add_scan', {
                lookupUrl: path('scan_quick_add_lookup'),
                confirmUrl: path('scan_quick_add_confirm'),
                csrfToken: csrfToken
            }) }}
        ></div>
    </div>

    <div class="modal fade" id="quick-add-confirm-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Part</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <h6 id="quick-add-part-name" class="mb-3"></h6>

                    <div class="mb-3">
                        <img id="quick-add-part-image" src="" alt="Part image" class="img-fluid img-thumbnail d-none" style="max-height: 180px;">
                    </div>

                    <div class="mb-3">
                        <label for="quick-add-amount" class="form-label">Amount</label>
                        <input type="number" id="quick-add-amount" class="form-control" min="0.0000001" step="any" value="1">
                    </div>

                    <button type="button" class="btn btn-outline-secondary btn-sm" data-action="click->pages--quick-add-scan#toggleLocation">
                        Set Storage Location
                    </button>

                    <div class="mt-3 d-none" id="quick-add-location-container">
                        <label for="quick-add-storage-location" class="form-label">Storage Location</label>
                        <select id="quick-add-storage-location" class="form-select">
                            <option value="">(none)</option>
                            {% for location in storageLocations %}
                                <option value="{{ location.id }}">{{ location.fullPath }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" data-action="click->pages--quick-add-scan#confirmAdd">Add</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

